# Copia este archivo a .env y ajusta con tus datos reales.

PORT=3000

# Conexión a MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=MandameApp
DB_USER=tu_usuario
DB_PASSWORD=tu_password

# Origen permitido para CORS
FRONTEND_URL=http://localhost:5173

# JWT
JWT_SECRET=una-cadena-larga-y-aleatoria-solo-tuya
JWT_EXPIRES_IN=12h

# Correo (opcional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Mandame <no-responder@mandame.com>"

# Google Drive (opcional) — subida automática de boletas.
# GOOGLE_DRIVE_KEY_FILE: ruta al JSON de la cuenta de servicio.
# GOOGLE_DRIVE_FOLDER_ID: ID de la carpeta raíz (compartida como
# Editor con el correo de esa cuenta de servicio).
GOOGLE_DRIVE_KEY_FILE=
GOOGLE_DRIVE_FOLDER_ID=
